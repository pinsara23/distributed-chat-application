# ==========================================
# DISTRIBUTED CHAT - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and replace the placeholder values with your actual secrets.
# NEVER commit your actual .env file to version control.

# PostgreSQL Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=chat_db

# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://admin:your_postgres_password_here@postgres:5432/chat_db
# Sync URL for Alembic Migrations (psycopg2)
SYNC_DATABASE_URL=postgresql://admin:your_postgres_password_here@postgres:5432/chat_db

# Redis Presence & Pub/Sub
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# Server Identification
SERVER_ID=chat-server-local

# Authentication (JWT)
JWT_SECRET_KEY=generate_a_random_32_byte_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Server-Side Column Encryption (if applicable)
MESSAGE_ENCRYPTION_KEY=generate_a_random_url_safe_base64_key_here