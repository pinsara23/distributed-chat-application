# ==========================================================================
# Distributed Chat - environment variables
# ==========================================================================
# Copy to .env and replace every placeholder. NEVER commit .env.
#
#   Server (docker compose): keep the values below. Compose overrides
#   DATABASE_URL / REDIS_URL / RABBITMQ_URL with the service names, so those
#   three only matter for running uvicorn directly on your machine.
#   Local development: use the "localhost" lines marked below.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=chat_db

# --- RabbitMQ (credentials for the broker container) ----------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_this_rabbitmq_password

# --- Connection strings read by the application ----------------------------
# Local development (services on localhost / WSL):
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/

# --- Server identity (compose sets this per container) ---------------------
SERVER_ID=chat-server-local

# --- Authentication (JWT) ---------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_random_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Deployment (docker compose only) ---------------------------------------
# Image tag to run: "latest", or a commit SHA to pin / roll back.
# IMAGE_TAG=latest
